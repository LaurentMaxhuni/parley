# --- Neon Postgres ---
# From your Neon project dashboard (Connection Details). Prefer the pooled
# connection string (the hostname contains "-pooler") for deployed/serverless use.
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# --- Neon Auth (Managed Better Auth) ---
# Neon Console -> your project -> Auth page -> Enable Auth -> Configuration tab
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-32+-character-random-secret"

# --- OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional but recommended by OpenRouter for analytics/rate-limit attribution
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_SITE_NAME="Parley"

# Optional: override any model tier without changing source code. Values are
# comma-separated in fallback order. Leave unset to use the maintained defaults.
# OPENROUTER_FAST_MODELS="nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-20b:free"
# OPENROUTER_STANDARD_MODELS="openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free"
# OPENROUTER_POWER_MODELS="nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free"
