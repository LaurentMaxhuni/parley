// Prisma schema for Parley
// Uses Prisma ORM 6.x (stable). Neon Auth (Managed Better Auth) manages its own
// user/session tables in a separate `neon_auth` schema behind the scenes, so we
// don't model users here — we just store the `userId` string from the auth
// session on each record below and use it to scope queries per user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionType {
  PRICING
  NEGOTIATION
}

enum DealStatus {
  LEAD
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum ScopeChangeStatus {
  RECOMMENDED
  APPROVED
  DECLINED
}

// One row per AI generation the user runs, so the dashboard can show history
// and chart Deal Health Score trends over time.
model SessionRecord {
  id        String      @id @default(cuid())
  userId    String
  type      SessionType

  // Free-form request the user submitted (product description, client message, etc.)
  input     Json

  // Structured AI response (pricing tiers, counter-offer draft, reasoning, etc.)
  output    Json

  // Only populated for NEGOTIATION sessions. 0-100, higher = stronger position.
  dealHealthScore Int?

  // Which OpenRouter model actually handled the request, for transparency
  // in the "tools I used" section of the project presentation.
  modelUsed String

  // A session can be linked to a deal later, so existing saved history stays valid.
  dealId    String?
  deal      Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([dealId, createdAt])
}

// A reusable client engagement. Each downstream artefact belongs to the same
// user-scoped deal so it cannot be read across accounts.
model Deal {
  id              String            @id @default(cuid())
  userId          String
  clientName      String
  title           String
  status          DealStatus        @default(LEAD)
  quotedValueCents Int?
  currency        String            @default("USD")
  targetCloseDate DateTime?
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions        SessionRecord[]
  proposals       Proposal[]
  scopeChanges    ScopeChange[]
  paymentSchedules PaymentSchedule[]

  @@index([userId, status, updatedAt])
}

model Proposal {
  id               String   @id @default(cuid())
  userId           String
  dealId           String
  pricingSessionId String?
  version          Int
  tierName         String
  tierPrice        String
  scope            String
  timeline         String
  exclusions       String
  content          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, version])
  @@index([userId, dealId, createdAt])
}

model ScopeChange {
  id         String            @id @default(cuid())
  userId     String
  dealId     String
  request    String
  approvedScope String
  status     ScopeChangeStatus @default(RECOMMENDED)
  output     Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  deal       Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId, dealId, createdAt])
}

model PaymentSchedule {
  id                 String   @id @default(cuid())
  userId             String
  dealId             String
  contractValueCents Int
  currency           String   @default("USD")
  timeline           String
  riskPreference     String
  output             Json
  isSelected         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId, dealId, createdAt])
}

// A short, per-user bucket used to protect the shared AI provider quota from
// bursts. The composite key lets Postgres reserve capacity atomically.
model GenerationRateLimit {
  userId       String
  windowStart  DateTime
  requestCount Int     @default(0)

  @@id([userId, windowStart])
}
